# Development only. Replace in production (random >=32-char value).
APP_ENV=development
DATABASE_URL=sqlite:///./.data/nextphase.db
STORAGE_DIR=./.data/media
# Opt-in S3-compatible storage. Leave local until a reviewed private bucket exists.
MEDIA_BACKEND=local
S3_ENDPOINT=
# S3_PUBLIC_ENDPOINT=https://reviewed-client-reachable-origin
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SIGNED_DOWNLOAD_SECONDS=60
# New capable sessions only; keep disabled for default local development.
DIRECT_UPLOADS_ENABLED=false
SIGNED_UPLOAD_SECONDS=60
JWT_SECRET=dev-only-replace-with-a-long-random-32-character-secret
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
MAX_UPLOAD_BYTES=314572800
MAX_SOURCE_SECONDS=600
ACCOUNT_STORAGE_BYTES=5368709120
MAX_RENDER_BYTES=67108864
RENDER_TIMEOUT_SECONDS=1200
WORKER_POLL_SECONDS=2
# Separate liveness pulse; never renews render leases.
WORKER_HEARTBEAT_SECONDS=10
# Standalone development defaults off; Compose worker enforces true separately.
# Requires cgroup v2 memory <=2 GiB, CPU <=2, PIDs <=128 when enabled.
WORKER_REQUIRE_LIMITS=false
WORKER_REQUIRE_SANDBOX=false
WORKER_LEASE_SECONDS=45
WORKER_RENEW_SECONDS=10
RETRY_BACKOFF_SECONDS=5
# Native development defaults to DB mode; configure_queue.py prepares private Valkey settings.
QUEUE_BACKEND=database
QUEUE_HOST=127.0.0.1
QUEUE_PORT=6380
QUEUE_PASSWORD=
QUEUE_TLS=false
MAX_ACTIVE_JOBS_PER_USER=3
MAX_PROCESSING_JOBS_PER_USER=1
UPLOAD_CHUNK_BYTES=1048576
UPLOAD_SESSION_HOURS=24
UPLOAD_PART_TIMEOUT_SECONDS=120
# Revocable access sessions and shared fixed-window authentication limits.
AUTH_SESSION_HOURS=24
# New logins use refresh families; AUTH_SESSION_HOURS is legacy only.
AUTH_ACCESS_MINUTES=15
AUTH_REFRESH_DAYS=30
AUTH_REFRESH_IDLE_DAYS=7
AUTH_REFRESH_RETRY_SECONDS=120
AUTH_REFRESH_IP_LIMIT=120
AUTH_WINDOW_SECONDS=900
AUTH_LOGIN_ACCOUNT_LIMIT=5
AUTH_LOGIN_IP_LIMIT=30
AUTH_REGISTER_IP_LIMIT=10
AUTH_PASSWORD_LIMIT=5
# Optional; all AI calls OFF for starter. Never put private keys in mobile EXPO_PUBLIC_ variables.
AI_PROVIDER=disabled
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
# Future verified backend-only billing settings; no charging in MVP.
BILLING_PROVIDER=disabled

# Authentication delivery defaults off. File backend remains development-only.
AUTH_MAIL_BACKEND=disabled
AUTH_MAIL_DIR=.data/auth-mail
AUTH_ACTION_MINUTES=15
AUTH_ACTION_EMAIL_LIMIT=3
# Resend is opt-in; prepare configuration privately, then perform approved inbox QA.
AUTH_MAIL_SEND_ENABLED=false
RESEND_API_KEY=
AUTH_MAIL_FROM=
# Comma-separated Fernet keys: primary first, retained decrypt-only keys afterward.
AUTH_MAIL_ENCRYPTION_KEYS=
# Required explicit 1–5 owned QA recipients in development/test.
AUTH_MAIL_RECIPIENTS=
AUTH_MAIL_DAILY_LIMIT=20
AUTH_MAIL_MONTHLY_LIMIT=500
AUTH_REQUIRE_VERIFIED_EMAIL=false

# Mounted server secrets: use NAME_FILE instead of NAME, never both.
# Supported: JWT_SECRET, DATABASE_URL, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY,
# QUEUE_PASSWORD, RESEND_API_KEY, AUTH_MAIL_ENCRYPTION_KEYS, RESTORE_JOURNAL_KEY.
# Example only: JWT_SECRET_FILE=/run/secrets/session-key (remove JWT_SECRET first).
# See docs/MONITORING_SECRETS_COSTS.md for file permissions and rotation.

# Global logical budgets; no paid credit/billing or physical disk quota.
API_REQUEST_CONCURRENCY=8
GLOBAL_ACTIVE_LIMIT=100
GLOBAL_PROCESSING_LIMIT=2
GLOBAL_STORAGE_BYTES=53687091200
INGRESS_LIMIT=4
GLOBAL_INGRESS_BYTES=1073741824
INGRESS_TIMEOUT_SECONDS=600
MIN_FREE_DISK_BYTES=134217728
OBSERVATION_RETENTION_DAYS=7

# Independent encrypted restore journal (Linux API; opt-in for development).
# Required by API readiness in staging/production. Never put it inside media/DB
# backups or reinitialize a lost stream. See docs/RESTORE_JOURNAL.md.
RESTORE_JOURNAL_DIR=
# Server-only Fernet key via RESTORE_JOURNAL_KEY_FILE preferred; never EXPO_PUBLIC.
RESTORE_JOURNAL_KEY=

# Optional application admission/claim pause from fresh operator cost reconciliation.
# Missing, malformed or >5-minute-old configured state fails closed; empty disables.
# This is NOT a provider billing stop. See docs/CONSOLIDATED_ACCEPTANCE.md.
BUDGET_STATE_FILE=

# Private English project-review pilot; no online ASR or preview rendering.
# Development/test only, with 1–5 explicit canonical app user UUIDs when enabled.
# Leave disabled until migration, ownership/deletion and phone acceptance checks.
ENGLISH_REVIEW_ENABLED=false
ENGLISH_REVIEW_USER_IDS=

# Optional private Gemini selection. Server only; see docs/GEMINI_CLIP_SELECTION.md.
# Keep Google project billing disabled; these gates do not inspect provider billing.
GEMINI_PLANNING_ENABLED=false
GEMINI_FREE_TIER_CONFIRMED=false
GEMINI_API_KEY=
GEMINI_API_KEY_FILE=
