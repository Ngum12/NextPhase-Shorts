{
  "name": "nextphase-shorts-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test:uploads": "node tests/uploads.test.cjs",
    "test:auth": "node tests/auth.test.cjs",
    "test:exports": "node tests/videoExports.test.cjs",
    "test:account": "node tests/accountDeletion.test.cjs",
    "test:recovery": "node tests/emailActions.test.cjs",
    "test:refresh": "node tests/refreshSession.test.cjs",
    "test": "npm run test:uploads && npm run test:auth && npm run test:exports && npm run test:account && npm run test:recovery && npm run test:refresh"
  },
  "dependencies": {
    "expo": "~54.0.0",
    "expo-constants": "~18.0.0",
    "expo-crypto": "~15.0.9",
    "expo-document-picker": "~14.0.0",
    "expo-file-system": "~19.0.0",
    "expo-linking": "~8.0.0",
    "expo-media-library": "~18.2.1",
    "expo-router": "~6.0.0",
    "expo-secure-store": "~15.0.0",
    "expo-sharing": "~14.0.0",
    "expo-status-bar": "~3.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.0"
  },
  "overrides": {
    "postcss": "8.5.32"
  }
}
